  "unicode/utf8.AppendRune" -> "unicode/utf8.appendRuneNonASCII";
  "unicode/utf8.EncodeRune" -> "unicode/utf8.encodeRuneNonASCII";
  "unicode/utf8.RuneCount" -> "unicode/utf8.RuneCountInString";
}
